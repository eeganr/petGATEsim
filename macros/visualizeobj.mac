/vis/enable
/vis/open OGL

/gate/geometry/setMaterialDatabase ./GateMaterials.db


/gate/world/geometry/setXLength       400. cm
/gate/world/geometry/setYLength       400. cm
/gate/world/geometry/setZLength       400. cm

/gate/run/initialize

/vis/scene/create

/vis/sceneHandler/attach scene-0

/control/execute Geometry.mac
/control/execute scatterphantomvol.mac

/gate/run/initialize

/vis/drawVolume

/control/execute scatterphantom.mac
/gate/source/LINE/visualize 5000 red 2
